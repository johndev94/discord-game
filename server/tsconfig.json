{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "baseUrl": "../",
    "outDir": "./dist",
    "paths": {
      "@common/*": ["common/*"]
    },

    "moduleResolution": "node",
    "moduleDetection": "force",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
